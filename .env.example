# ---- App ----
NODE_ENV=development
PORT=3000
# Must be an explicit origin, not "*": credentialed CORS forbids wildcards.
CORS_ORIGIN=http://localhost:5173

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Dev only. Deployed environments must run migrations and set this to false.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Sessions ----
# Which SessionStore implementation to bind: postgres | redis
SESSION_STORE=postgres
SESSION_COOKIE_NAME=sid
# Must be true anywhere served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
# Durations accept s, m, h, d. Idle slides on activity; absolute never moves.
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=24h
SESSION_REMEMBER_IDLE_TTL=30d
SESSION_REMEMBER_ABSOLUTE_TTL=90d

# ---- CSRF ----
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_NAME=csrf_token

# ---- Argon2id (OWASP second-recommended profile) ----
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
